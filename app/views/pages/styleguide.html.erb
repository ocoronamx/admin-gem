<%#
  Guía de estilos (Styleguide / Design System).
  Funciona como catálogo de referencia visual para los componentes de DaisyUI,
  paleta de colores semántica y la colección de íconos disponibles en `IconsHelper`.
%>
<% add_breadcrumb "Design System" %>

<div class="space-y-8">
  <% content_for :title, "Nuevo usuario" %>

  <h1 class="text-2xl font-semibold mb-4">
    AdminGem Design System
  </h1>

  <%= render(layout: "components/card", locals: { title: "Icons (IconsHelper)" }) do %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8 gap-4">
      <% IconsHelper::ICONS.each_key do |name| %>
        <div class="flex flex-col items-center justify-center gap-2 p-4 border border-base-200 rounded-lg bg-base-100 hover:border-primary hover:text-primary transition-colors text-base-content/70 text-center" title="<%= name %>">
          <%= icon(name) %>
          <span class="text-xs truncate w-full"><%= name %></span>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render(layout: "components/card", locals: { title: "Charts (ApexCharts)" }) do %>
    <p class="text-sm text-base-content/60 -mt-2 mb-4">
      Los colores salen del tema activo — probá el toggle de arriba, se repintan solos.
    </p>

    <div class="w-full overflow-x-auto">
      <div class="grid sm:grid-cols-2 gap-4 min-w-[500px] sm:min-w-0">
        <%= chart_tag type: :line, height: 240,
              series: [
                { name: "Usuarios activos", data: [ 30, 40, 35, 50, 49, 60, 70 ] },
                { name: "Sesiones", data: [ 20, 28, 25, 33, 36, 44, 52 ] }
              ],
              xaxis: { categories: %w[Lun Mar Mié Jue Vie Sáb Dom] } %>

        <%= chart_tag type: :donut, height: 240,
              series: [ 44, 33, 23 ],
              labels: %w[Admin Editor Invitado] %>
      </div>
    </div>
  <% end %>

  <%= render(layout: "components/card", locals: { title: "Formularios (AdminFormBuilder)" }) do %>
    <p class="text-sm text-base-content/60 -mt-2">
      Cada campo trae su fieldset, label y validator-hint solo. El de "Email" fuerza
      un error de servidor para mostrar el estado inválido en rojo.
    </p>

    <%= form_with model: @demo_form, url: styleguide_path, method: :get do |form| %>
      <div class="grid sm:grid-cols-2 gap-x-4">
        <%= form.text_field :name, label: "Nombre", class: "w-full" %>
        <%= form.email_field :email, label: "Email", class: "w-full" %>
      </div>


      <div class="w-full overflow-x-auto">
        <div class="grid sm:grid-cols-2 gap-4  sm:min-w-0">
          <%= form.text_area :bio, label: "Biografía", hint: "Máximo 280 caracteres.", rows: 3, class: "w-full" %>
          <%= form.date_field :birthdate, label: "Fecha de nacimiento", class: "w-full" %>
          <%= form.select :country, [ [ "Argentina", "ar" ], [ "México", "mx" ], [ "España", "es" ],
                                      [ "Chile", "cl" ], [ "Colombia", "co" ] ], 
                                      { label: "País", include_blank: "Selecciona un país" }, 
                                      { class: "w-full select select-bordered" } %>
        </div>
      </div>
      <div class="w-full overflow-x-auto">
        <%= form.tom_select :tags, [  [ "Rails", "rails" ], 
                                      [ "Hotwire", "hotwire" ], 
                                      [ "Tailwind", "tailwind" ],
                                      [ "Pundit", "pundit" ], 
                                      [ "Postgres", "postgres" ] ], 
                                    label: "Tecnologías (Tom Select)", 
                                    multiple: true, class: "w-full min-w-[500px]" %>
        <div class="grid sm:grid-cols-2 gap-4  sm:min-w-0">
          <div class="flex flex-col w-full gap-1">
          </div>
        </div>
      </div>

      <div class="w-full overflow-x-auto">
        <div class="grid sm:grid-cols-2 gap-4  sm:min-w-0">
          <fieldset class="fieldset w-full [&_label]:whitespace-normal [&_label]:text-left">
            <%= form.check_box :newsletter, label: "Quiero recibir noticias por correo" %>
          </fieldset>
        </div>
      </div>


      <!-- Acciones -->
      <div class="md:col-span-2 lg:col-span-4 mt-2">
        <%= render "components/button", text: "Enviar (demo, no hace nada)", 
                                        type: "submit", 
                                        variant: :primary,
                                        class: "w-full" %>
      </div>
    <% end %>
  <% end %>

  <%= render(layout: "components/card", locals: { title: "Alertas" }) do %>
    <%= render "components/alert", variant: :info, message: "Esto es información." %>
    <%= render "components/alert", variant: :success, message: "La operación fue exitosa." %>
    <%= render "components/alert", variant: :warning, message: "Revisa esto antes de continuar." %>
    <%= render "components/alert", variant: :error, message: "Algo salió mal.", dismissible: true %>
  <% end %>

  <%= render(layout: "components/card", locals: { title: "Span Badges" }) do %>
    <%= form_with model: @demo_form, url: styleguide_path, method: :get do |form| %>
    
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 w-full">
        <span class="badge badge-primary w-full h-auto whitespace-normal py-1 text-center break-words">
          primary </span>
        <span class="badge badge-secondary w-full h-auto whitespace-normal py-1 text-center break-words">
          secondary </span>
        <span class="badge badge-accent w-full h-auto whitespace-normal py-1 text-center break-words">
          accent </span>
        <span class="badge badge-neutral w-full h-auto whitespace-normal py-1 text-center break-words">
          neutral </span>
        <span class="badge badge-info w-full h-auto whitespace-normal py-1 text-center break-words">
          info </span>
        <span class="badge badge-success w-full h-auto whitespace-normal py-1 text-center break-words">
          success </span>
        <span class="badge badge-warning w-full h-auto whitespace-normal py-1 text-center break-words">
          warning </span>
        <span class="badge badge-error w-full h-auto whitespace-normal py-1 text-center break-words">
          error </span>
        <span class="badge badge-disabled w-full h-auto whitespace-normal py-1 text-center break-words">
          disabled </span>
      </div>
    <% end %>
  <% end %>

  <%= render(layout: "components/card", locals: { title: "Buttons" }) do %>
    <form action="<%= styleguide_path %>" accept-charset="UTF-8" method="get">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 w-full">
        <%= render "components/button", text: "primary",  type: "submit", 
                                        variant: :primary, class: "w-full" %>
        <%= render "components/button", text: "secondary",  type: "submit", 
                                        variant: :secondary, class: "w-full" %>
        <%= render "components/button", text: "accent",  type: "submit", 
                                        variant: :accent, class: "w-full" %>
        <%= render "components/button", text: "neutral",  type: "submit", 
                                        variant: :neutral, class: "w-full" %>
        <%= render "components/button", text: "success",  type: "submit", 
                                        variant: :success, class: "w-full" %>
        <%= render "components/button", text: "warning",  type: "submit", 
                                        variant: :warning, class: "w-full" %>
        <%= render "components/button", text: "error",  type: "submit", 
                                        variant: :error, class: "w-full" %>
        <%= render "components/button", text: "disabled",  type: "submit", 
                                        disabled: true, class: "w-full" %>
      </div>
    </form>
  <% end %>

  <section class="card bg-base-100 shadow p-6 space-y-3">
    <h2 class="font-medium">Card (render layout:, contenido libre)</h2>
    <%= render(layout: "components/card", locals: { title: "Ejemplo" }) do %>
      <p class="text-base-content/70">Este contenido viene de un bloque, no de un local.</p>
    <% end %>
  </section>

  <%= render(layout: "components/card", locals: { title: "Badges de estado y Modal" }) do %>
    <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-3 gap-4 w-full">
      <%= status_badge("Activo", variant: :success) %>
      <%= status_badge("Inactivo", variant: :neutral) %>
      <div class="fieldset">
        <%= render "components/button", text: "Abrir modal", type: "button", class: "btn w-full",
                                        data: { controller: "modal",
                                                modal_id_value: "demo_modal",
                                                action: "modal#open" } %>
        <p class="text-xs text-base-content/60 mt-1">
          Los diálogos de confirmación (<code>data: { turbo_confirm: "..." }</code>) usan el mismo
          mecanismo de <code>&lt;dialog&gt;</code> — se verán en acción en Setup 10 con "Eliminar".
        </p>
      </div>
    </div>

    <%= render(layout: "components/modal", locals: { id: "demo_modal", title: "Modal de ejemplo" }) do %>
      <p class="text-base-content/70 mb-4">Contenido del modal, definido con un bloque igual que Card.</p>
      <div class="modal-action">
        <form method="dialog">
          <%= render "components/button", text: "Cerrar",  type: "submit", 
                                          variant: :neutral, class: "w-full" %>
        </form>
      </div>
    <% end %>
  <% end %>

  <%= render(layout: "components/card", locals: { title: "Empty state" }) do %>
    <%= render "components/empty_state", title: "Sin catálogos todavía",
          description: "Cuando exista el módulo, aquí se listarán.", icon: :squares_2x2 %>
  <% end %>

</div>
