<%#
  Vista parcial para la renderización de mensajes de notificación (flash).
  Itera sobre los mensajes almacenados en la sesión (notice, alert, success, etc.)
  y les aplica dinámicamente las clases de color correspondientes de DaisyUI.
%>
<% flash.each do |type, message| %>
  <%# Mapea el tipo de mensaje a una clase CSS de DaisyUI (ej. alert-success, alert-error) %>
  <div class="alert <%= flash_alert_class(type) %> shadow-sm mb-4" role="alert">
    <span><%= message %></span>
  </div>
<% end %>