<%
  title       = local_assigns[:title]
  actions     = local_assigns[:actions]
  extra_class = local_assigns.fetch(:class, "")
%>
<div class="card bg-base-100 shadow <%= extra_class %>">
  <div class="card-body">
    <% if title || actions %>
      <div class="flex items-start justify-between mb-2 gap-4">
        
        <% if title %>
          <!-- Cambiamos break-words por break-all -->
          <h2 class="card-title min-w-0 break-all">
            <%= title %>
          </h2>
        <% end %>
        
        <% if actions %>
          <div class="flex gap-2 shrink-0"><%= actions %></div>
        <% end %>
        
      </div>
    <% end %>
    <%= yield %>
  </div>
</div>
