<%
  text        = local_assigns.fetch(:text)
  variant     = local_assigns.fetch(:variant, :nil)
  size        = local_assigns.fetch(:size, :md)
  href        = local_assigns[:href]
  method      = local_assigns[:method]
  confirm     = local_assigns[:confirm]
  disabled    = local_assigns.fetch(:disabled, false)
  loading     = local_assigns.fetch(:loading, false)
  icon_name   = local_assigns[:icon]
  extra_class = local_assigns.fetch(:class, "")
  type        = local_assigns.fetch(:type, "button")
  data        = local_assigns.fetch(:data, {})

  variant_class = {
    primary: "btn-primary", secondary: "btn-secondary", accent: "btn-accent",
    neutral: "btn-neutral", info: "btn-info", success: "btn-success",
    warning: "btn-warning", error: "btn-error", outline: "btn-outline",
    ghost: "btn-ghost", nil: ""
  }.fetch(variant.to_sym, "btn-primary")

  size_class = { sm: "btn-sm", md: "", lg: "btn-lg" }.fetch(size.to_sym, "")
  # classes = ["btn", variant_class, size_class, extra_class].reject(&:blank?).join(" ")
  classes = ["btn h-auto whitespace-normal py-2 break-words", variant_class, size_class, extra_class].reject(&:blank?).join(" ")
%>

<% if href %>
  <%= link_to href, class: classes, data: { turbo_method: method, turbo_confirm: confirm }.compact.merge(data) do %>
    <% if loading %>
      <span class="loading loading-spinner loading-sm"></span>
    <% elsif icon_name %>
      <%= icon(icon_name, css_class: "size-4") %>
    <% end %>
    <%= text %>
  <% end %>
<% else %>
  <%= button_tag type: type, class: classes, disabled: disabled || loading, data: data do %>
    <% if loading %>
      <span class="loading loading-spinner loading-sm"></span>
    <% elsif icon_name %>
      <%= icon(icon_name, css_class: "size-4") %>
    <% end %>
    <%= text %>
  <% end %>
<% end %>
